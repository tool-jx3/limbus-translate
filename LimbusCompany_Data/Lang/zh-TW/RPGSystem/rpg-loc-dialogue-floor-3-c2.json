{
  "dataList": [
    {
      "key": "D3543",
      "texts": [
        {
          "index": 0,
          "text": "無數事物的殘骸混雜在一起。大多是跟著流行隨波逐流的卡其派的衣服。"
        }
      ]
    },
    {
      "key": "D3582",
      "texts": [
        {
          "index": 0,
          "text": "彷彿想要剪斷一切的渴望冷卻殆盡，刀刃鈍化的剪刀。"
        }
      ]
    },
    {
      "key": "D3581",
      "texts": [
        {
          "index": 0,
          "text": "線團依然被妥善管理著。"
        }
      ]
    },
    {
      "key": "D3572",
      "texts": [
        {
          "index": 0,
          "text": "黃金色、丹紅色全都褪去了色澤，只殘留下劣質的皮。"
        }
      ]
    },
    {
      "key": "D3517",
      "texts": [
        {
          "index": 0,
          "text": "原本掛著的皮革大多被撕扯下來了。可以看見像是齒痕的痕跡。"
        }
      ]
    },
    {
      "key": "D3520",
      "texts": [
        {
          "index": 0,
          "text": "展示櫃之間可以看見依然保存良好的衣服。"
        }
      ]
    },
    {
      "key": "D3563",
      "texts": [
        {
          "index": 0,
          "text": "是漆黑派的人台模特兒。究竟是百貨公司的人台模特兒，還是外頭的人台模特兒。如今似乎沒有區分的意義了。"
        }
      ]
    },
    {
      "key": "D3560",
      "texts": [
        {
          "index": 0,
          "text": "蒙著一層灰塵變得灰白的衣服。帶著黃金色的絲線一根也沒留下。"
        }
      ]
    },
    {
      "key": "D3557",
      "texts": [
        {
          "index": 0,
          "text": "斷裂的縫隙間沾附著骨頭碎片與肉片。"
        }
      ]
    },
    {
      "key": "D3555",
      "texts": [
        {
          "index": 0,
          "text": "乍看之下完好無缺，但黃金松脂縫合的部分全被撕裂了。"
        }
      ]
    },
    {
      "key": "D3550",
      "texts": [
        {
          "index": 0,
          "text": "從管中傳來微弱的震動。將頭靠近管線便能聽見從內側傳來的聲音。"
        },
        {
          "index": 1,
          "text": "[依循秩序而行……而行行行……]"
        },
        {
          "index": 2,
          "text": "[銘記苦痛……銘記苦痛痛痛……]"
        }
      ]
    },
    {
      "key": "D3551",
      "texts": [
        {
          "index": 0,
          "text": "昔日的聲音無法離去仍在原地徘徊。"
        }
      ]
    },
    {
      "key": "D3544",
      "texts": [
        {
          "index": 0,
          "text": "壞掉的管線前堆積著錄音帶。一陣翻找後，經常在漆黑派專櫃聽見的聲音，以拉長失真的狀態播放後中斷了。"
        }
      ]
    },
    {
      "key": "D3539",
      "texts": [
        {
          "index": 0,
          "text": "已經老舊不堪的骰子。那段漫長的歲月裡看來都沒有人投擲過。"
        }
      ]
    },
    {
      "key": "D3529",
      "texts": [
        {
          "index": 0,
          "text": "被某人刻意刻意破壞的排風扇。原本堆積其中的灰塵已經被清理得一乾二淨。"
        }
      ]
    },
    {
      "key": "D3536",
      "texts": [
        {
          "index": 0,
          "text": "傳遞聲音的管線如絲線般糾纏於一塊。"
        }
      ]
    },
    {
      "key": "D3530",
      "texts": [
        {
          "index": 0,
          "text": "排風扇正在運轉。感覺周遭的空氣似乎稍微清澈了一點。"
        }
      ]
    },
    {
      "key": "D3527",
      "texts": [
        {
          "index": 0,
          "text": "倒塌的講台間，看見了漆黑派的鑑定評價書。"
        },
        {
          "index": 1,
          "text": "[3F 樓層經理大人。]"
        },
        {
          "index": 2,
          "text": "[聲音大人出於某種理由而離席的現在，您的廣播對於漆黑派來說是必要的。]"
        },
        {
          "index": 3,
          "text": "[在連可供追隨的潮流消失以前，請務必蒞臨漆黑派。]"
        },
        {
          "index": 4,
          "text": "……既然離開座位的話，難道是投靠了漆黑派嗎？",
          "speaker": "辛克萊"
        },
        {
          "index": 5,
          "text": "也可能正好相反。也不能否定未投靠漆黑派，而受到制裁的可能性。",
          "speaker": "奧提斯"
        },
        {
          "index": 6,
          "text": "無論如何，他終究會選擇其中一方吧。恐怕難以堅持中立到最後。",
          "speaker": "奧提斯"
        }
      ]
    },
    {
      "key": "D3528",
      "texts": [
        {
          "index": 0,
          "text": "漆黑派的鑑定評價書殘留於此。看來不只是送出過一次，地上散落著3、4張。"
        }
      ]
    },
    {
      "key": "D3525",
      "texts": [
        {
          "index": 0,
          "text": "是崩塌的柱子。這種程度應該可以跳過去……"
        },
        {
          "index": 1,
          "text": "<莫梭，這個不能直接跳過去嗎？>",
          "speaker": "但丁"
        },
        {
          "index": 2,
          "text": "……我試試看。",
          "speaker": "莫梭"
        },
        {
          "index": 3,
          "text": "舒展筋骨的莫梭用盡全力試著跳過柱子……"
        },
        {
          "index": 4,
          "text": "但彷彿被某種東西絆住般，直接一頭撞向了地面。"
        },
        {
          "index": 5,
          "text": "<……抱歉。>",
          "speaker": "但丁"
        },
        {
          "index": 6,
          "text": "莫梭像是在說沒事似地拍了拍身上的衣服，重新站起來。"
        }
      ]
    },
    {
      "key": "D3526",
      "texts": [
        {
          "index": 0,
          "text": "是倒塌的柱子。就連莫梭都跳不過去。"
        }
      ]
    },
    {
      "key": "D3521",
      "texts": [
        {
          "index": 0,
          "text": "眼球……曾經是這樣的東西塞滿裡頭。已經腐爛得不成形了，恐怕無法使用了。"
        }
      ]
    },
    {
      "key": "D3505",
      "texts": [
        {
          "index": 0,
          "text": "沙發沒有傳出任何聲音。"
        }
      ]
    },
    {
      "key": "D3516",
      "texts": [
        {
          "index": 0,
          "text": "與歲月流逝無關，看起來是某人刻意弄倒的柱子。"
        }
      ]
    },
    {
      "key": "D3506",
      "texts": [
        {
          "index": 0,
          "text": "地上散落著大量死去的鳥與磁帶拉長的錄音帶。"
        }
      ]
    },
    {
      "key": "D3504",
      "texts": [
        {
          "index": 0,
          "text": "是所有皮革都被撕扯下來的裝飾品。"
        }
      ]
    },
    {
      "key": "D3503",
      "texts": [
        {
          "index": 0,
          "text": "是修補達人的剪刀。即使歷經漫長歲月鈍化後，似乎依然還能剪斷東西。"
        }
      ]
    }
  ]
}
