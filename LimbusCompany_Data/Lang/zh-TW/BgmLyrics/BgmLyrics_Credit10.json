{
  "dataList": [
    {
      "id": "0",
      "content": "<color=#293B95>追逐陰影的每日</color>"
    },
    {
      "id": "1",
      "content": "<color=#293B95>只剩下空洞的回憶</color>"
    },
    {
      "id": "2",
      "content": "<color=#293B95>猶如被火焰席捲而過一般</color>"
    },
    {
      "id": "3",
      "content": "<color=#293B95>僅殘留灰色的餘燼在我掌中</color>"
    },
    {
      "id": "4",
      "content": "<color=#293B95>我未曾停歇地向前奔跑</color>"
    },
    {
      "id": "5",
      "content": "<color=#293B95>那些讓我感到壓抑的時光</color>"
    },
    {
      "id": "6",
      "content": "<color=#293B95>最終是否也會令我感到懷念？</color>"
    },
    {
      "id": "7",
      "content": "<color=#293B95>在遙遠未來的某一天</color>"
    },
    {
      "id": "8",
      "content": "<color=#293B95>當驀然回首時</color>"
    },
    {
      "id": "9",
      "content": "<color=#293B95>希望我仍能展露笑容</color>"
    },
    {
      "id": "10",
      "content": "<color=#293B95>在我所剩的時間中</color>"
    },
    {
      "id": "11",
      "content": "<color=#293B95>現在正是該向前邁進的時刻</color>"
    },
    {
      "id": "12",
      "content": "<color=#293B95>燃燒自己直到不復存在</color>"
    },
    {
      "id": "13",
      "content": "<color=#293B95>彷若蠟燭一般</color>"
    },
    {
      "id": "14",
      "content": "<color=#293B95>沒有喘息的空檔</color>"
    },
    {
      "id": "15",
      "content": "<color=#293B95>就被拋入動盪的日常</color>"
    },
    {
      "id": "16",
      "content": "<color=#293B95>但願我仍能走在自己的道路上</color>"
    },
    {
      "id": "17",
      "content": "<color=#293B95>在遙遠未來的某一天</color>"
    },
    {
      "id": "18",
      "content": "<color=#293B95>當驀然回首時</color>"
    },
    {
      "id": "19",
      "content": "<color=#293B95>希望我仍能展露笑容</color>"
    },
    {
      "id": "20",
      "content": "<color=#293B95>讓我飛向遙遠　遙遠的彼方</color>"
    },
    {
      "id": "21",
      "content": "<color=#293B95>像夜空中的鳥兒一樣　觸碰星斗</color>"
    },
    {
      "id": "22",
      "content": "<color=#293B95>雖然今晚　今晚肯定又會再次到來</color>"
    },
    {
      "id": "23",
      "content": "<color=#293B95>但沒事的　因為大家都還活著</color>"
    },
    {
      "id": "24",
      "content": "<color=#293B95>沒事的</color>"
    }
  ]
}
