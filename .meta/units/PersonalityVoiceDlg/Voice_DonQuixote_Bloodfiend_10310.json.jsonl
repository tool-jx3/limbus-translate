{"key":"PersonalityVoiceDlg/Voice_DonQuixote_Bloodfiend_10310.json|/dataList/7/desc","kr_sha":"e5d82a8beeb0245da4845fe51a4668374a236c0f0c6717796be8507a51eef742","zh":"同步後對話 1","origin":"paratranz","since":"raw-20261029","rules":"563a0bf5b2d7ab2426f09b1eb3566a5beec92bf0"}
